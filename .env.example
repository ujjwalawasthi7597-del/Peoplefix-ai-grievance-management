# CivicFix Environment Configuration

PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Connection (Optional: if empty, robust in-memory & local JSON persistent store is used automatically)
MONGODB_URI=

# JWT Secrets for Custom Authentication
JWT_ACCESS_SECRET=civicfix_jwt_access_secret_production_ready_token_key_2026
JWT_REFRESH_SECRET=civicfix_jwt_refresh_secret_production_ready_token_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Configuration (Supports: gemini, groq, ollama, rule-based)
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
# AI Studio automatically injects GEMINI_API_KEY from user secrets
GEMINI_API_KEY=

# Storage and Notification Providers
STORAGE_PROVIDER=local
EMAIL_PROVIDER=
